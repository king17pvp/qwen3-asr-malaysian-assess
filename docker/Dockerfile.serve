# vLLM serving / load-test image: the `serve` extra (vLLM 0.30.0, torch cu129, `http`).
#   docker build -f docker/Dockerfile.serve -t asr-assess-serve .
# The host needs an NVIDIA driver >= CUDA 12.9 and the NVIDIA Container Toolkit. nvcc comes
# from the locked pip wheels, so a CUDA runtime/devel base image is not needed.
FROM nvidia/cuda:12.9.1-base-ubuntu24.04

# build-essential: Triton / FlashInfer JIT-compile host code; ffmpeg: torchcodec's decoders;
# git: run records stamp the commit; make + curl: Makefile targets and scripts/vllm_serve_two.sh.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ffmpeg git make curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /usr/local/bin/

ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_SYNC=1 \
    PATH=/app/.venv/bin:$PATH \
    HF_HOME=/cache/huggingface \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencies first, so code changes do not reinstall vLLM.
COPY pyproject.toml uv.lock .python-version ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --extra serve

COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra serve \
    && git config --system --add safe.directory /app

EXPOSE 8000
CMD ["bash", "scripts/vllm_serve.sh", "configs/vllm/tuned.yaml"]
