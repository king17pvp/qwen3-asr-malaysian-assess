# Training / evaluation / HF-server image: the `train` + `data` + `http` extras and dev tools.
#   docker build -f docker/Dockerfile.train -t asr-assess-train .
# torch cu126 wheels bundle the CUDA runtime, so the host needs only an NVIDIA driver
# (>= CUDA 12.6) and the NVIDIA Container Toolkit. The base image's NVIDIA_REQUIRE_CUDA makes
# the container refuse an older driver at start-up instead of failing inside torch.
FROM nvidia/cuda:12.6.3-base-ubuntu24.04

# git: run records stamp the commit; make: the Makefile targets; curl: health checks.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git make curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /usr/local/bin/

ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_SYNC=1 \
    PATH=/app/.venv/bin:$PATH \
    HF_HOME=/cache/huggingface \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencies first, so code changes do not reinstall torch.
COPY pyproject.toml uv.lock .python-version ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --group dev --extra train --extra data --extra http

COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --group dev --extra train --extra data --extra http \
    && git config --system --add safe.directory /app

CMD ["make", "help"]
